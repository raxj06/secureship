generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TrackingEvent {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  location  String?
  timestamp DateTime @default(now())

  @@index([orderId])
}
